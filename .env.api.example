# Linky API environment — **example only**. Copy the variables you need into the
# repo-root `.env` (same file used by Docker Compose and the Go API). Nothing
# loads this filename at runtime.
#
# Web-only variables live in `.env.web.example` (also example-only).

# =============================================================================
# Core
# =============================================================================

NODE_ENV=development
PORT=7270
# Required in production (comma-separated origins; global "*" is not allowed).
# Optional in dev (defaults to http://localhost:3000).
# CORS_ORIGIN=http://localhost:3000

# =============================================================================
# Clerk (server-side secrets only — publishable key goes in the same `.env` or apps/web)
# =============================================================================

CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

# =============================================================================
# Supabase
# =============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
# SUPABASE_TIMEOUT=10000
# GRAPHQL_BACKEND=supabase

# =============================================================================
# S3-compatible storage (often the Supabase Storage S3 endpoint)
# =============================================================================

S3_BUCKET=your-bucket
S3_REGION=ap-south-1
S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me

# =============================================================================
# Cloudflare Realtime SFU (required; the Go API runs SFU only)
# =============================================================================

CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=
# Optional override (defaults to https://rtc.live.cloudflare.com/v1)
# CLOUDFLARE_REALTIME_BASE_URL=
# Optional, only for ops/dashboard scripts
# CLOUDFLARE_ACCOUNT_ID=

# =============================================================================
# OpenAI / OpenAI-compatible AI provider (required)
# Works with the official OpenAI API or any compatible gateway / self-hosted
# endpoint that exposes /v1/chat/completions and /v1/embeddings.
# =============================================================================

OPENAI_API_KEY=sk-replace_me
OPENAI_BASE_URL=https://api.openai.com/v1
# Models: prefer admin AI config (models.*). Env fallbacks:
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BROADCAST_MODEL=gpt-4o-mini
# OPENAI_REPORT_SUMMARY_MODEL=gpt-4o-mini
# OPENAI_REQUEST_TIMEOUT_MS=60000
# OPENAI_EMBEDDING_TIMEOUT_MS=60000

# =============================================================================
# Redis (in-process worker queue)
# =============================================================================

# Cloud provider (Upstash, Redis Cloud, etc): set the full URL with creds.
#   REDIS_URL=rediss://default:****@my-cloud-redis.example.com:6379
# Or split creds across env vars on top of a bare URL:
#   REDIS_URL=rediss://my-cloud-redis.example.com:6379
#   REDIS_USERNAME=default
#   REDIS_PASSWORD=replace_me
# Local dev / docker-compose: leave unset or use the in-network service.
#   REDIS_URL=redis://redis:6379
REDIS_URL=redis://localhost:6379
# REDIS_USERNAME=
# REDIS_PASSWORD=

# Worker pool concurrency (number of in-process job consumers).
JOB_WORKER_CONCURRENCY=4

# =============================================================================
# Web Push VAPID
# =============================================================================

VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me

# =============================================================================
# Optional tunables
# =============================================================================

# SHUTDOWN_TIMEOUT=30000
# JSON_BODY_SIZE_LIMIT=500kb
# SOCKET_MAX_HTTP_BUFFER_SIZE=8388608
# RATE_LIMIT_WINDOW_MS=30000
# RATE_LIMIT_MAX_REQUESTS=100
# LOG_LEVEL=info

# =============================================================================
# Embedding job tuning (tiktoken-go; chunk sizes are in tokens, not characters).
# EMBED_MAX_CHUNK_TOKENS must stay below EMBED_MAX_CONTEXT_TOKENS (8192 for
# OpenAI text-embedding-3-*). Set EMBED_TIKTOKEN_MODEL when the effective embedding
# model is a custom route name but tokenization should follow a known OpenAI model.
# =============================================================================

# EMBED_MAX_CONTEXT_TOKENS=8192
# EMBED_MAX_CHUNK_TOKENS=7680
# EMBED_CHUNK_OVERLAP_TOKENS=256
# EMBED_TIKTOKEN_MODEL=
# EMBED_BATCH_SIZE=8
# EMBED_MAX_CHUNKS_PER_JOB=64
# EMBED_MAX_TOTAL_INPUT_TOKENS_PER_JOB=2097152
# EMBED_EXPECTED_DIMENSION=1536
# EMBED_RETRY_COUNT=2
# EMBED_RETRY_BASE_DELAY_MS=400
# EMBED_MAX_BATCH_TOTAL_TOKENS=131072

# =============================================================================
# Observability (server)
# =============================================================================

# SENTRY_DSN=
# SENTRY_ENABLED=false
