# Linky E2E (pytest + Selenium + CloakBrowser) — **example only**.
# Copy the variables you need into the repo-root `.env` or `e2e/pytest/.env`.
# `linky_e2e.config` loads both paths (root first, then e2e/pytest/.env overrides).
#
# Run from e2e/pytest:
#   uv sync && uv run ensure-cloak
#   uv run pytest tests/video_chat -m video_chat
#
# Clerk test accounts (hardcoded in linky_e2e/test_data/clerk_test_auth.py, not env):
#   Email pattern: {name}+clerk_test@{CLERK_TEST_DOMAIN}
#   OTP: 424242
#   Sign-up password: ValidPass123!

# =============================================================================
# Required
# =============================================================================

# Next.js app under test (must match NEXT_PUBLIC_APP_URL when running locally)
BASE_TEST_URL=http://localhost:3000

# =============================================================================
# API (direct HTTP tests, e.g. video_chat queue-status)
# =============================================================================

# Go API base URL. Falls back to NEXT_PUBLIC_API_URL, then http://localhost:7270
API_URL=http://localhost:7270
# NEXT_PUBLIC_API_URL=http://localhost:7270

# =============================================================================
# Browser / runner
# =============================================================================

# Headed browser (any truthy: 1, true, yes)
# HEADED=1
# PWHEADED=1
# PWDEBUG=1

# Skip human-paced delays between steps (recommended for CI)
# RUN_FAST=1

# Chrome --ignore-certificate-errors (self-signed / local HTTPS)
# E2E_IGNORE_HTTPS_ERRORS=1
# IGNORE_HTTPS_ERRORS=1

# WebDriverWait default timeout in seconds
E2E_TIMEOUT_SEC=30

# Browser viewport (CloakBrowser / Chrome)
E2E_VIEWPORT_WIDTH=1280
E2E_VIEWPORT_HEIGHT=720

# =============================================================================
# Clerk test auth
# =============================================================================

# Clerk test email domain for +clerk_test addresses
CLERK_TEST_DOMAIN=linky.now
# SIGNUP_TEST_DOMAIN=linky.now

# Full reset-password URL — required for tests/auth/test_reset_password.py (tests skip if unset)
# CLERK_RESET_PASSWORD_URL=https://your-app.example/reset-password?__clerk_ticket=...

# Signup email auto-remove position: prefix | suffix | include
# SIGNUP_EMAIL_AUTO_REMOVE_POSITION=include

# =============================================================================
# Breach / compromised-password tests (tests/auth/test_breach.py)
# =============================================================================

# All four required for the password-change breach test; suite skips if BREACH_TEST_EMAIL is unset
# BREACH_TEST_EMAIL=
# BREACH_TEST_OTP=
# BREACH_TEST_PASSWORD=
# BREACH_TEST_NEW_PASSWORD=
