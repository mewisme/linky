# Linky E2E (pytest + Selenium + CloakBrowser) — **example only**.
# Copy the variables you need into the repo-root `.env` or `e2e/pytest/.env`.
# `linky_e2e.config` loads both paths (root first, then e2e/pytest/.env overrides).
#
# Run from e2e/pytest:
#   uv sync && uv run ensure-cloak
#   uv run refresh-auth
#   uv run pytest tests/video_chat -m video_chat

# =============================================================================
# Required
# =============================================================================

BASE_TEST_URL=http://localhost:3000

# =============================================================================
# API (direct HTTP tests, e.g. video_chat queue-status)
# =============================================================================

API_URL=http://localhost:7270
# NEXT_PUBLIC_API_URL=http://localhost:7270

# =============================================================================
# Browser / runner
# =============================================================================

# HEADED=1
# PWHEADED=1
# PWDEBUG=1
# RUN_FAST=1
# E2E_IGNORE_HTTPS_ERRORS=1
# IGNORE_HTTPS_ERRORS=1

E2E_TIMEOUT_SEC=30
E2E_VIEWPORT_WIDTH=1280
E2E_VIEWPORT_HEIGHT=720

# =============================================================================
# Clerk test auth
# =============================================================================

CLERK_TEST_DOMAIN=linky.now
# SIGNUP_TEST_DOMAIN=linky.now

# Shared defaults for all test users (per-user vars override these)
E2E_TEST_PASSWORD=ValidPass123!
E2E_TEST_OTP=424242

# =============================================================================
# Test users (required: user1 + user2 for video_chat; user3–user7 optional)
# =============================================================================
# Email defaults to {id}+clerk_test@{CLERK_TEST_DOMAIN} when unset.
# Storage defaults to .auth/{id}.json

E2E_USER1_EMAIL=user1+clerk_test@linky.now
E2E_USER1_PASSWORD=ValidPass123!
E2E_USER1_OTP=424242
E2E_USER1_STORAGE=.auth/user1.json
# E2E_USER1_FIRST_NAME=Test
# E2E_USER1_LAST_NAME=User1

E2E_USER2_EMAIL=user2+clerk_test@linky.now
E2E_USER2_PASSWORD=ValidPass123!
E2E_USER2_OTP=424242
E2E_USER2_STORAGE=.auth/user2.json
# E2E_USER2_FIRST_NAME=Test
# E2E_USER2_LAST_NAME=User2

# Optional extra accounts (only loaded when E2E_USER{N}_EMAIL is set)
# E2E_USER3_EMAIL=user3+clerk_test@linky.now
# E2E_USER3_PASSWORD=ValidPass123!
# E2E_USER3_OTP=424242
# E2E_USER3_STORAGE=.auth/user3.json

# =============================================================================
# Optional auth flows
# =============================================================================

# CLERK_RESET_PASSWORD_URL=https://your-app.example/reset-password?__clerk_ticket=...
# SIGNUP_EMAIL_AUTO_REMOVE_POSITION=include

# Breach tests (tests/auth/test_breach.py) — skip if BREACH_TEST_EMAIL unset
# BREACH_TEST_EMAIL=
# BREACH_TEST_OTP=
# BREACH_TEST_PASSWORD=
# BREACH_TEST_NEW_PASSWORD=
