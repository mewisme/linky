# Linky environment template (copy to `.env` at repo root).
# API loads this file from apps/api via dotenv; web and workers read the same root `.env` in local dev.
# Never commit real secrets. See apps/api/src/config/schema.ts and apps/web/src/shared/env/ for validation rules.

# =============================================================================
# Core (required for API + most local dev)
# =============================================================================

NODE_ENV=development

# --- Clerk (API + web) ---
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/call
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/call
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/call
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/call

# --- Supabase (API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# --- Redis (API, workers, cache, queues) ---
REDIS_URL=redis://127.0.0.1:6379

# --- S3-compatible storage (API media; often Supabase Storage S3 endpoint) ---
S3_BUCKET=your-bucket
S3_REGION=ap-south-1
S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me

# --- Cloudflare TURN (API WebRTC, used when VIDEO_PROVIDER=p2p) ---
CLOUDFLARE_TURN_API_TOKEN=replace_me
CLOUDFLARE_TURN_KEY_ID=replace_me

# --- Cloudflare Realtime SFU (API WebRTC, used when VIDEO_PROVIDER=cloudflare_sfu) ---
# Switch the active media transport. p2p (default) keeps the existing browser-to-browser flow.
VIDEO_PROVIDER=p2p
# Required when VIDEO_PROVIDER=cloudflare_sfu. Get from Cloudflare dash → Realtime → Apps.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=
# Optional override (defaults to https://rtc.live.cloudflare.com/v1)
# CLOUDFLARE_REALTIME_BASE_URL=
# Optional, only for ops/dashboard scripts
# CLOUDFLARE_ACCOUNT_ID=

# --- Ollama / embeddings (API + worker jobs) ---
OLLAMA_EMBEDDING_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=replace_me

# --- Web Push VAPID (API) ---
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=replace_me
VAPID_PRIVATE_KEY=replace_me

# =============================================================================
# Web (apps/web) — required for `pnpm dev:web` / `pnpm build:web`
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:7270
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=replace_me
NEXT_PUBLIC_GIPHY_API_KEY=replace_me
OPENPANEL_API_URL=https://api.openpanel.dev
OPENPANEL_CLIENT_SECRET=replace_me

# =============================================================================
# API optional tunables
# =============================================================================

PORT=7270
# Required in production (comma-separated origins; no wildcard). Optional in development.
# CORS_ORIGIN=http://localhost:3000
INTERNAL_API_PORT=7271
# Docker / production worker transport (set on api + worker; omit for native dev using INTERNAL_API_BASE_URL)
# INTERNAL_API_SOCKET_PATH=/var/run/linky/api.sock
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
USE_MEMORY_MATCHMAKING=false
CACHE_NAMESPACE_VERSION=v1
SHUTDOWN_TIMEOUT=30000
JSON_BODY_SIZE_LIMIT=500kb
SOCKET_MAX_HTTP_BUFFER_SIZE=8388608
REDIS_TIMEOUT=5000
SUPABASE_TIMEOUT=10000
RATE_LIMIT_WINDOW_MS=30000
RATE_LIMIT_MAX_REQUESTS=100
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_CLOUD_MODEL=ministral-3:14b
OLLAMA_EMBEDDING_TIMEOUT=60000

# =============================================================================
# Worker (Go production / Node dev) — one of socket path or base URL required
# =============================================================================

# Native dev (API internal listener on 7271):
INTERNAL_API_BASE_URL=http://127.0.0.1:7271
INTERNAL_API_TIMEOUT_MS=120000
INTERNAL_API_MAX_RETRIES=3
INTERNAL_API_RETRY_BASE_DELAY_MS=500

# =============================================================================
# Observability (optional)
# =============================================================================

# API (apps/api/src/config/env.ts)
# SENTRY_DSN=
# SENTRY_ENABLED=false

# Web build / runtime
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENABLED=false
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_ENABLED=false

# =============================================================================
# Web dev-only (optional)
# =============================================================================

# Comma-separated origins for Next.js allowedDevOrigins
# NEXT_PUBLIC_ALLOWED_DEV_ORIGINS=

# =============================================================================
# E2E / Playwright (optional; not loaded by API or web at runtime)
# =============================================================================

# CLERK_RESET_PASSWORD_URL=
