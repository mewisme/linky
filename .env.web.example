# Linky web environment — **example only**. Copy the variables you need into the
# repo-root `.env` (merge with values from `.env.api.example`). Next.js reads
# env from `apps/web/` as well (e.g. `.env.local`); this file is not loaded by name.
# `NEXT_PUBLIC_*` keys are exposed to the browser bundle.

# =============================================================================
# Core
# =============================================================================

NODE_ENV=development

NEXT_PUBLIC_API_URL=http://localhost:7270
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Clerk (publishable + redirects — `CLERK_SECRET_KEY` belongs in the same root `.env`)
# =============================================================================

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/call
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/call
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/call
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/call

# =============================================================================
# Analytics / tracking
# =============================================================================

NEXT_PUBLIC_GIPHY_API_KEY=replace_me

# =============================================================================
# Sentry
# =============================================================================

# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENABLED=false
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_ENABLED=false

# =============================================================================
# Dev-only
# =============================================================================

# Comma-separated origins for Next.js allowedDevOrigins
# NEXT_PUBLIC_ALLOWED_DEV_ORIGINS=

# =============================================================================
# E2E / Playwright (only used by the test runner; not loaded at runtime)
# =============================================================================

# CLERK_RESET_PASSWORD_URL=
