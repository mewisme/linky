def doPull = false
def localVersion = null
def remoteVersion = null
def branchName = null
def linkyApiUrl = null
def dockerImageApiUrl = null
def dockerComposeFile = null
def envCredentialsId = null

pipeline {
  agent any

  options {
    timeout(time: 15, unit: 'MINUTES')
  }

  environment {
    LINKY_API_URL = 'https://api.linkynow.site'
    LINKY_API_DEV_URL = 'https://api-dev.linkynow.site'
    DOCKER_IMAGE_API_URL = 'https://registry.hub.docker.com/v2/repositories/mewthedev/linky'
    DOCKER_IMAGE_API_DEV_URL = 'https://registry.hub.docker.com/v2/repositories/mewthedev/linky-dev'
  }

  stages {

    stage('Checkout Code') {
      steps {
        checkout scm
        script {
          branchName = env.BRANCH_NAME ?: env.GIT_BRANCH?.replaceFirst(/^origin\//, '')
          echo "- Updated branch: ${branchName}"

          if (branchName == 'main') {
            linkyApiUrl = env.LINKY_API_URL
            dockerImageApiUrl = env.DOCKER_IMAGE_API_URL
            dockerComposeFile = 'docker-compose.yml'
            envCredentialsId = 'linky-env-prod'
          } else if (branchName == 'dev') {
            linkyApiUrl = env.LINKY_API_DEV_URL
            dockerImageApiUrl = env.DOCKER_IMAGE_API_DEV_URL
            dockerComposeFile = 'docker-compose.dev.yml'
            envCredentialsId = 'linky-env-dev'
          } else {
            error "Unsupported branch: ${branchName}"
          }

          echo "- API URL: ${linkyApiUrl}"
          echo "- Docker API URL: ${dockerImageApiUrl}"
          echo "- Docker Compose File: ${dockerComposeFile}"
          echo "- Environment Credentials ID: ${envCredentialsId}"
        }
      }
    }

     stage('Live vs Repo Version') {
      steps {
        script {
          echo '- Checking local & remote versions'

          def remoteVersionJson = readJSON file: 'package.json'
          remoteVersion = remoteVersionJson?.version ?: null
          echo "- Remote version: $remoteVersion"

          try {
            def localVersionResponse = httpRequest url: "${linkyApiUrl}/healthz"
            def localVersionJson = readJSON text: localVersionResponse.content
            localVersion = localVersionJson?.version ?: null
            echo "- Local version: $localVersion"

            def compareResult = compareVersions v1: localVersion, v2: remoteVersion
            def compareResultMessage = compareResult == 0 ? 'matched' : compareResult == 1 ? 'newer' : 'older'
            echo "- Compare result: $compareResultMessage"

            if (compareResult <= 0) {
              doPull = true
            }
            echo 'Local & Remote versions compared'
          } catch (Exception e) {
            echo "- Healthz fetch failed (${e.message});"
            echo 'Forcing pull...'
            doPull = true
          }
        }
      }
    }

    stage('Docker Image Sync') {
      steps {
        script {
          waitUntil {
            sleep time: 10, unit: 'SECONDS'

            echo '- Checking Docker Hub & Remote versions'

            def tagsDockerHubResponse = httpRequest url: "${dockerImageApiUrl}/tags"
            def tagsDockerHubJson = readJSON text: tagsDockerHubResponse.content

            def latestDigest = tagsDockerHubJson.results.find { tag -> tag.name == "latest" }?.images[0]?.digest
            def matchedTag = latestDigest
              ? tagsDockerHubJson.results.find { tag ->
                  tag.name != "latest" && tag.images.any { img -> img.digest == latestDigest }
                }
              : null

            def dockerVersion = matchedTag?.name

            echo "Docker Hub version: ${dockerVersion}"
            echo "Remote version: ${remoteVersion}"
            echo "Local version: ${localVersion}"

            def dockerMatchesRemote =
              dockerVersion &&
              compareVersions(v1: remoteVersion, v2: dockerVersion) == 0

            if (dockerMatchesRemote) {
              echo 'Docker Hub & Remote versions are the same'

              def dockerMatchesLocal =
                compareVersions(v1: localVersion, v2: dockerVersion) == 0

              if (dockerMatchesLocal) {
                echo 'Docker Hub & Local versions are the same'
                echo 'No need to deploy'
                doPull = false
              }

              return true
            }

            echo 'Docker Hub version is not synced with Remote yet'
            echo 'Waiting for Github Actions to complete'
            return false
          }
        }
      }
    }

    stage('Prepare Env') {
      when {
        expression { doPull }
      }
      steps {
        withCredentials([file(credentialsId: envCredentialsId, variable: 'ENV_FILE')]) {
          sh '''
            cp "$ENV_FILE" .env
            chmod 600 .env
          '''
          echo 'Env files prepared'
        }
      }
    }

    stage('Deploy') {
      when {
        expression { doPull }
      }
      steps {
        sh '''
          docker compose -f ${dockerComposeFile} up -d --pull always --remove-orphans
        '''
      }
    }
  }

  post {
    always {
      cleanWs()
    }
    success {
      echo 'Linky deployed successfully'
    }
    failure {
      echo 'Linky deployment failed'
    }
  }
}