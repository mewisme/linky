type Admin {
  reports(
    status: String
    reporterUserId: ID
    reportedUserId: ID
    limit: Int = 50
    offset: Int = 0
  ): AdminReportsPage!
  report(id: ID!): JSON
  interestTags(limit: Int = 50, offset: Int = 0): GenericTablePage!
  expBonuses(limit: Int = 50, offset: Int = 0): GenericTablePage!
  config: JSON!
  configByKey(key: String!): JSON
  broadcasts(limit: Int = 50, offset: Int = 0): JSON!
  embeddings(limit: Int = 50, offset: Int = 0): GenericTablePage!
  users(page: Int = 1, limit: Int = 50, role: String, search: String, deleted: Boolean): JSON!
  user(id: ID!): JSON
  aiConfig: JSON!
  aiModels(capability: String): JSON
}

type AdminReportsPage {
  data: JSON!
  count: Int!
  limit: Int!
  offset: Int!
}

type GenericTablePage {
  data: JSON!
  count: Int!
}
