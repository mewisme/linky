{
  "name": "linky",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "exports": {
    "./playwright-test": "./e2e/playwright/fixtures/test.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "build:api": "cd apps/api && go build -ldflags=\"-s -w\" -o bin/api ./src/cmd/api",
    "build:web": "turbo run build --filter=@ws/web",
    "dev": "turbo run dev",
    "dev:api": "cd apps/api && go run github.com/air-verse/air@v1.65.2",
    "dev:web": "turbo run dev --filter=@ws/web",
    "start": "turbo run start",
    "start:api": "./apps/api/bin/api",
    "start:web": "turbo run start --filter=@ws/web",
    "lint": "turbo run lint",
    "lint:web": "turbo run lint --filter=@ws/web",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check-types:web": "turbo run check-types --filter=@ws/web",
    "docker:build:api": "docker build -f Dockerfile -t linky-api:local .",
    "test": "pnpm exec playwright test --config e2e/playwright/playwright.config.ts",
    "test:ui": "pnpm exec playwright test --config e2e/playwright/playwright.config.ts --ui",
    "test:debug": "pnpm exec playwright test --config e2e/playwright/playwright.config.ts --debug",
    "test:trace": "pnpm exec playwright test --config e2e/playwright/playwright.config.ts --trace",
    "test:report": "pnpm exec playwright show-report",
    "test:report:last": "node e2e/playwright/scripts/show-last-report.mjs",
    "test:report:excel": "node e2e/playwright/scripts/json-to-excel.mjs",
    "test:codegen": "pnpm exec playwright codegen",
    "upver": "node scripts/generate-changelog.js && node scripts/version-upgrade.js"
  },
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f",
  "devDependencies": {
    "@types/node": "25.9.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "catalog:"
  }
}
